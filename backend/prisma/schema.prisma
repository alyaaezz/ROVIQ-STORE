generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  VODAFONE_CASH
  INSTAPAY
}

enum PaymentStatus {
  UNPAID
  PROOF_UPLOADED
  VERIFIED
  REJECTED
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  category    String   @default("Hoodies")
  price       Int
  salePrice   Int?
  images      String[]
  colors      String[]
  sizes       String[]
  stock       Int      @default(0)
  active      Boolean  @default(true)
  showStock   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique
  customerName     String
  phone            String
  address          String
  city             String
  notes            String        @default("")
  subtotal         Int
  shipping         Int           @default(0)
  total            Int
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentReference String        @default("")
  paymentProofUrl  String?
  status           OrderStatus   @default(PENDING)
  createdAt        DateTime      @default(now())
  items            OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  image     String?
  size      String
  color     String
  quantity  Int
  unitPrice Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}