# Node modules (مجلدات المكتبات الضخمة - لا تُرفع أبداً)
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables (ملفات البيئة السرية التي تحتوي على باسوردات القاعدة والأدمن)
.env
backend/.env
frontend/.env

# Build outputs (ملفات البناء والإنتاج المؤقتة)
dist/
build/
backend/dist/
frontend/dist/

# Logs & Debug files (ملفات السجلات والأخطاء المؤقتة)
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor generated files (ملفات النظام والـ VS Code المؤقتة)
.DS_Store
Thumbs.db
.vscode/